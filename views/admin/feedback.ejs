<%- include('../partials/header') %>

<div class="app-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="app-main">
    <%- include('../partials/topbar') %>

    <main class="app-content">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div class="page-header-info">
          <h1>Student Meal Feedback & Analytics</h1>
          <p>Monitor dining satisfaction scores, evaluate caterer performance, and read student comments</p>
        </div>
      </div>

      <!-- Meal Rating KPI Summary Cards -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-content">
            <h4>Overall Rating</h4>
            <div class="stat-value"><%= overallAvg %> <span style="font-size: 1rem; color: #f59e0b;"><i class="fa-solid fa-star"></i></span></div>
            <div class="stat-subtext"><%= totalCount %> verified student ratings</div>
          </div>
          <div class="stat-icon-box stat-icon-amber">
            <i class="fa-solid fa-star-half-stroke"></i>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-content">
            <h4>Breakfast Avg</h4>
            <div class="stat-value"><%= mealStats.Breakfast.avg %> <span style="font-size: 1rem; color: #f59e0b;"><i class="fa-solid fa-star"></i></span></div>
            <div class="stat-subtext"><%= mealStats.Breakfast.count %> reviews</div>
          </div>
          <div class="stat-icon-box stat-icon-amber">
            <i class="fa-solid fa-sun"></i>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-content">
            <h4>Lunch Avg</h4>
            <div class="stat-value"><%= mealStats.Lunch.avg %> <span style="font-size: 1rem; color: #f59e0b;"><i class="fa-solid fa-star"></i></span></div>
            <div class="stat-subtext"><%= mealStats.Lunch.count %> reviews</div>
          </div>
          <div class="stat-icon-box stat-icon-emerald">
            <i class="fa-solid fa-utensils"></i>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-content">
            <h4>Dinner Avg</h4>
            <div class="stat-value"><%= mealStats.Dinner.avg %> <span style="font-size: 1rem; color: #f59e0b;"><i class="fa-solid fa-star"></i></span></div>
            <div class="stat-subtext"><%= mealStats.Dinner.count %> reviews</div>
          </div>
          <div class="stat-icon-box stat-icon-blue">
            <i class="fa-solid fa-moon"></i>
          </div>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="filter-bar">
        <form action="/admin/feedback" method="GET" class="filter-form">
          <select name="mealType" class="form-select" style="max-width: 170px;">
            <option value="all" <%= filters.mealType === 'all' ? 'selected' : '' %>>All Meals</option>
            <option value="Breakfast" <%= filters.mealType === 'Breakfast' ? 'selected' : '' %>>Breakfast</option>
            <option value="Lunch" <%= filters.mealType === 'Lunch' ? 'selected' : '' %>>Lunch</option>
            <option value="Snacks" <%= filters.mealType === 'Snacks' ? 'selected' : '' %>>Snacks</option>
            <option value="Dinner" <%= filters.mealType === 'Dinner' ? 'selected' : '' %>>Dinner</option>
          </select>

          <select name="rating" class="form-select" style="max-width: 170px;">
            <option value="all" <%= filters.rating === 'all' ? 'selected' : '' %>>All Star Ratings</option>
            <option value="5" <%= filters.rating === '5' ? 'selected' : '' %>>5 Stars Only</option>
            <option value="4" <%= filters.rating === '4' ? 'selected' : '' %>>4 Stars</option>
            <option value="3" <%= filters.rating === '3' ? 'selected' : '' %>>3 Stars</option>
            <option value="2" <%= filters.rating === '2' ? 'selected' : '' %>>2 Stars</option>
            <option value="1" <%= filters.rating === '1' ? 'selected' : '' %>>1 Star (Critical)</option>
          </select>

          <button type="submit" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-filter"></i> Filter
          </button>
          <a href="/admin/feedback" class="btn btn-secondary btn-sm">Reset</a>
        </form>
      </div>

      <!-- Reviews Table -->
      <div class="card">
        <div class="card-header">
          <h3><i class="fa-solid fa-comments" style="color: var(--primary);"></i> Student Meal Reviews (<%= feedbacks.length %>)</h3>
        </div>
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Student</th>
                <th>Meal</th>
                <th>Rating</th>
                <th>Student Comment</th>
              </tr>
            </thead>
            <tbody>
              <% if (feedbacks && feedbacks.length > 0) { %>
                <% feedbacks.forEach(function(f) { %>
                  <tr>
                    <td><%= f.date %></td>
                    <td>
                      <strong><%= f.student ? f.student.name : 'Unknown' %></strong>
                      <div style="font-size: 0.75rem; color: var(--slate-500);"><%= f.student ? f.student.studentId : '' %></div>
                    </td>
                    <td><strong><%= f.mealType %></strong></td>
                    <td>
                      <div class="star-rating">
                        <% for (let i = 1; i <= 5; i++) { %>
                          <i class="fa-<%= i <= f.rating ? 'solid' : 'regular' %> fa-star"></i>
                        <% } %>
                        <span style="color: var(--slate-700); font-weight: 700; margin-left: 0.35rem; font-size: 0.8rem;">(<%= f.rating %>/5)</span>
                      </div>
                    </td>
                    <td><%= f.comment || 'No written comment provided' %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align: center; color: var(--slate-400); padding: 3rem;">
                    No feedback records match the chosen filter.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
