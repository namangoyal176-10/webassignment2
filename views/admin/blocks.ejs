<%- include('../partials/header') %>

<div class="app-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="app-main">
    <%- include('../partials/topbar') %>

    <main class="app-content">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div class="page-header-info">
          <h1>Hostel Blocks Management</h1>
          <p>Configure residential buildings, gender allocations, and monitor building-level bed occupancy</p>
        </div>
        <div class="page-actions">
          <button type="button" class="btn btn-primary btn-sm" data-modal-target="#addBlockModal">
            <i class="fa-solid fa-plus"></i> Add New Block
          </button>
        </div>
      </div>

      <!-- Blocks Grid -->
      <div class="grid-3" style="margin-bottom: 2rem;">
        <% blocks.forEach(function(b) { %>
          <% const percent = b.totalBeds > 0 ? Math.round((b.occupiedBeds / b.totalBeds) * 100) : 0; %>
          <div class="card">
            <div class="card-header">
              <div>
                <h3><%= b.name %></h3>
                <span style="font-size: 0.75rem; color: var(--slate-500); text-transform: uppercase; font-weight: 600;">Block Code: <%= b.blockNumber %></span>
              </div>
              <span class="badge <%= b.gender === 'Girls' ? 'badge-partially-occupied' : 'badge-available' %>">
                <i class="fa-solid fa-venus-mars"></i> <%= b.gender %>
              </span>
            </div>

            <div class="card-body">
              <p style="font-size: 0.85rem; color: var(--slate-600); margin-bottom: 1.25rem;">
                <%= b.description || 'Modern student housing block equipped with security and common lounges.' %>
              </p>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
                <div style="background: var(--slate-50); padding: 0.65rem 0.85rem; border-radius: var(--radius-md); border: 1px solid var(--slate-200);">
                  <div style="font-size: 0.7rem; color: var(--slate-500); text-transform: uppercase;">Total Rooms</div>
                  <div style="font-size: 1.2rem; font-weight: 800; color: var(--slate-900);"><%= b.roomCount %></div>
                </div>
                <div style="background: var(--slate-50); padding: 0.65rem 0.85rem; border-radius: var(--radius-md); border: 1px solid var(--slate-200);">
                  <div style="font-size: 0.7rem; color: var(--slate-500); text-transform: uppercase;">Available Beds</div>
                  <div style="font-size: 1.2rem; font-weight: 800; color: var(--success);"><%= b.availableBeds %></div>
                </div>
              </div>

              <!-- Occupancy Progress -->
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.35rem;">
                  <span>Occupancy</span>
                  <span><%= b.occupiedBeds %> / <%= b.totalBeds %> Beds (<%= percent %>%)</span>
                </div>
                <div class="progress">
                  <div class="progress-bar <%= percent >= 90 ? 'bg-danger' : percent >= 60 ? 'bg-warning' : 'bg-success' %>" style="width: <%= percent %>%;"></div>
                </div>
              </div>
            </div>

            <div class="card-footer" style="justify-content: space-between;">
              <button type="button" class="btn btn-outline btn-sm" data-modal-target="#editBlockModal-<%= b._id %>">
                <i class="fa-solid fa-pen-to-square"></i> Edit
              </button>

              <form action="/admin/blocks/<%= b._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this block? This is only allowed if no students are currently residing here.');" style="margin: 0;">
                <button type="submit" class="btn btn-danger btn-sm">
                  <i class="fa-solid fa-trash-can"></i> Delete
                </button>
              </form>
            </div>
          </div>

          <!-- Edit Block Modal -->
          <div class="modal-backdrop" id="editBlockModal-<%= b._id %>">
            <div class="modal-dialog">
              <div class="modal-header">
                <h4>Edit Block <%= b.name %></h4>
                <button type="button" class="modal-close" data-modal-close>&times;</button>
              </div>
              <form action="/admin/blocks/<%= b._id %>" method="POST">
                <div class="modal-body">
                  <div class="form-group">
                    <label class="form-label">Block Name *</label>
                    <input type="text" name="name" class="form-control" value="<%= b.name %>" required>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Gender Allocation *</label>
                    <select name="gender" class="form-select" required>
                      <option value="Boys" <%= b.gender === 'Boys' ? 'selected' : '' %>>Boys</option>
                      <option value="Girls" <%= b.gender === 'Girls' ? 'selected' : '' %>>Girls</option>
                      <option value="Co-ed" <%= b.gender === 'Co-ed' ? 'selected' : '' %>>Co-ed</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control"><%= b.description %></textarea>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary btn-sm" data-modal-close>Cancel</button>
                  <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                </div>
              </form>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Add New Block Modal -->
      <div class="modal-backdrop" id="addBlockModal">
        <div class="modal-dialog">
          <div class="modal-header">
            <h4>Add New Hostel Block</h4>
            <button type="button" class="modal-close" data-modal-close>&times;</button>
          </div>
          <form action="/admin/blocks" method="POST">
            <div class="modal-body">
              <div class="form-group">
                <label class="form-label" for="newBlockName">Block Name *</label>
                <input type="text" id="newBlockName" name="name" class="form-control" placeholder="E.g., Aryabhata Residence" required>
              </div>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                  <label class="form-label" for="newBlockCode">Block Code / Identifier *</label>
                  <input type="text" id="newBlockCode" name="blockNumber" class="form-control" placeholder="E.g., A, B, H1" required>
                </div>
                <div class="form-group">
                  <label class="form-label" for="newBlockGender">Gender Allocation *</label>
                  <select name="gender" id="newBlockGender" class="form-select" required>
                    <option value="Boys" selected>Boys</option>
                    <option value="Girls">Girls</option>
                    <option value="Co-ed">Co-ed</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="newBlockDesc">Description</label>
                <textarea name="description" id="newBlockDesc" class="form-control" placeholder="Optional notes regarding facilities or location..."></textarea>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary btn-sm" data-modal-close>Cancel</button>
              <button type="submit" class="btn btn-primary btn-sm">Create Block</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
