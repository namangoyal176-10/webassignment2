<%- include('../partials/header') %>

<div class="app-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="app-main">
    <%- include('../partials/topbar') %>

    <main class="app-content">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div class="page-header-info">
          <h1>Weekly Mess Menu Publisher</h1>
          <p>Update the college dining timetable across all seven days with breakfast, lunch, snacks, and dinner options</p>
        </div>
      </div>

      <form action="/admin/mess-menu" method="POST">
        <div class="card" style="margin-bottom: 1.5rem;">
          <div class="card-body">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="menuTitle">Timetable Title / Academic Term</label>
              <input type="text" id="menuTitle" name="title" class="form-control" value="<%= menu ? menu.title : 'Standard Weekly Mess Timetable' %>" required>
            </div>
          </div>
        </div>

        <div class="mess-schedule-grid" style="margin-bottom: 2rem;">
          <% days.forEach(function(dayKey) { %>
            <% const dayMenu = menu ? menu[dayKey] : null; %>
            <div class="card">
              <div class="card-header" style="background: var(--slate-50);">
                <h3 style="text-transform: capitalize;"><i class="fa-solid fa-calendar-day" style="color: var(--primary);"></i> <%= dayNames[dayKey] %></h3>
              </div>
              <div class="card-body" style="display: flex; flex-direction: column; gap: 0.85rem;">
                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label" style="font-size: 0.75rem; color: #b45309; text-transform: uppercase;">
                    <i class="fa-solid fa-sun"></i> Breakfast
                  </label>
                  <input type="text" name="<%= dayKey %>_breakfast" class="form-control" value="<%= dayMenu ? dayMenu.breakfast : '' %>" placeholder="Breakfast menu...">
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label" style="font-size: 0.75rem; color: #047857; text-transform: uppercase;">
                    <i class="fa-solid fa-utensils"></i> Lunch
                  </label>
                  <input type="text" name="<%= dayKey %>_lunch" class="form-control" value="<%= dayMenu ? dayMenu.lunch : '' %>" placeholder="Lunch dishes...">
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label" style="font-size: 0.75rem; color: #c2410c; text-transform: uppercase;">
                    <i class="fa-solid fa-mug-hot"></i> Evening Snacks
                  </label>
                  <input type="text" name="<%= dayKey %>_snacks" class="form-control" value="<%= dayMenu ? dayMenu.snacks : '' %>" placeholder="Evening snacks...">
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label" style="font-size: 0.75rem; color: #4338ca; text-transform: uppercase;">
                    <i class="fa-solid fa-moon"></i> Dinner
                  </label>
                  <input type="text" name="<%= dayKey %>_dinner" class="form-control" value="<%= dayMenu ? dayMenu.dinner : '' %>" placeholder="Dinner dishes...">
                </div>
              </div>
            </div>
          <% }); %>
        </div>

        <div style="text-align: right; position: sticky; bottom: 1rem; z-index: 40; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(8px); padding: 1rem; border-radius: var(--radius-lg); border: 1px solid var(--slate-200); box-shadow: var(--shadow-lg);">
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-cloud-arrow-up"></i> Publish Updated Timetable
          </button>
        </div>
      </form>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
