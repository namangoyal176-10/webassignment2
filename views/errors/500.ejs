<%- include('../partials/header') %>

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at top, #fef2f2 0%, #f8fafc 80%); padding: 2rem 1rem;">
  <div class="card" style="max-width: 500px; width: 100%; text-align: center; padding: 2.5rem; box-shadow: var(--shadow-lg);">
    <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--danger-light); color: var(--danger); display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 1.5rem auto;">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <h1 style="font-size: 3rem; font-weight: 800; color: var(--slate-900); line-height: 1;">500</h1>
    <h3 style="margin: 0.75rem 0 0.5rem 0; font-size: 1.25rem;">Server Encountered an Error</h3>
    <p style="color: var(--slate-500); font-size: 0.9rem; margin-bottom: 2rem;">
      An unexpected internal server error occurred while processing your request. Please try again in a few moments.
    </p>
    <% if (typeof error !== 'undefined' && error && error.message) { %>
      <div style="background: var(--slate-900); color: #fca5a5; font-family: monospace; font-size: 0.75rem; text-align: left; padding: 1rem; border-radius: var(--radius-md); overflow-x: auto; margin-bottom: 1.5rem;">
        <%= error.message %>
      </div>
    <% } %>
    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <a href="/" class="btn btn-outline btn-sm"><i class="fa-solid fa-house"></i> Home</a>
      <a href="/login" class="btn btn-primary btn-sm"><i class="fa-solid fa-arrow-rotate-left"></i> Re-login</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
