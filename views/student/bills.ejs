<%- include('../partials/header') %>

<div class="app-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="app-main">
    <%- include('../partials/topbar') %>

    <main class="app-content">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div class="page-header-info">
          <h1>My Mess Invoices</h1>
          <p>Monthly mess billing calculated based on attendance records and daily meal rates</p>
        </div>
      </div>

      <!-- Financial Summary Cards -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-content">
            <h4>Total Outstanding Due</h4>
            <div class="stat-value" style="color: <%= totalDue > 0 ? 'var(--danger)' : 'var(--success)' %>;">₹<%= totalDue %></div>
            <div class="stat-subtext"><%= totalDue > 0 ? 'Pending dues require clearance' : 'All mess invoices cleared' %></div>
          </div>
          <div class="stat-icon-box stat-icon-amber">
            <i class="fa-solid fa-receipt"></i>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-content">
            <h4>Generated Invoices</h4>
            <div class="stat-value"><%= bills.length %></div>
            <div class="stat-subtext">Total monthly billing cycles</div>
          </div>
          <div class="stat-icon-box stat-icon-indigo">
            <i class="fa-solid fa-file-invoice"></i>
          </div>
        </div>
      </div>

      <!-- Invoices Table -->
      <div class="card">
        <div class="card-header">
          <h3><i class="fa-solid fa-list-numeric" style="color: var(--primary);"></i> Billing History</h3>
        </div>
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Billing Period</th>
                <th>Days Present</th>
                <th>Daily Rate</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Issued On</th>
                <th>Payment Date</th>
              </tr>
            </thead>
            <tbody>
              <% if (bills && bills.length > 0) { %>
                <% bills.forEach(function(b) { %>
                  <tr>
                    <td><strong><%= b.month %> <%= b.year %></strong></td>
                    <td><%= b.daysPresent %> Days</td>
                    <td>₹<%= b.perDayRate %> / day</td>
                    <td style="font-weight: 700; color: var(--slate-900);">₹<%= b.totalAmount %></td>
                    <td>
                      <span class="badge <%= b.status === 'Paid' ? 'badge-paid' : 'badge-unpaid' %>">
                        <%= b.status %>
                      </span>
                    </td>
                    <td><%= new Date(b.generatedAt).toLocaleDateString() %></td>
                    <td><%= b.paidAt ? new Date(b.paidAt).toLocaleDateString() : '—' %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" style="text-align: center; color: var(--slate-400); padding: 2.5rem;">
                    No mess bills generated yet for your account.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
