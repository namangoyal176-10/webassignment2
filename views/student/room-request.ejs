<%- include('../partials/header') %>

<div class="app-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="app-main">
    <%- include('../partials/topbar') %>

    <main class="app-content">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div class="page-header-info">
          <h1>Request Hostel Room</h1>
          <p>Submit your preferred residential block and occupancy type for warden evaluation</p>
        </div>
      </div>

      <div class="grid-2">
        <!-- Room Request Submission Form -->
        <div class="card">
          <div class="card-header">
            <h3><i class="fa-solid fa-file-circle-plus" style="color: var(--primary);"></i> New Allotment Application</h3>
          </div>
          <div class="card-body">
            <% if (student.room) { %>
              <div class="alert alert-warning" style="margin-bottom: 0;">
                <i class="fa-solid fa-circle-exclamation"></i>
                <div>
                  <strong>Room Already Allotted:</strong> You are already assigned to Room <%= student.room.roomNumber %>. If you wish to switch rooms, please use the <a href="/student/room-change" style="font-weight: 700; text-decoration: underline;">Room Change Request</a> page.
                </div>
              </div>
            <% } else if (hasPendingRequest) { %>
              <div class="alert alert-warning" style="margin-bottom: 0;">
                <i class="fa-solid fa-clock"></i>
                <div>
                  <strong>Application Pending:</strong> You already have an active room allotment request awaiting review. You will be notified as soon as the warden processes it.
                </div>
              </div>
            <% } else { %>
              <form action="/student/room-request" method="POST">
                <div class="form-group">
                  <label class="form-label" for="preferredBlock">Preferred Hostel Block *</label>
                  <select name="preferredBlock" id="preferredBlock" class="form-select" required>
                    <option value="" disabled selected>-- Select a Block --</option>
                    <% blocks.forEach(function(b) { %>
                      <option value="<%= b._id %>"><%= b.name %> (<%= b.gender %> Block, Code: <%= b.blockNumber %>)</option>
                    <% }); %>
                  </select>
                </div>

                <div class="form-group">
                  <label class="form-label" for="preferredRoomType">Preferred Room Type *</label>
                  <select name="preferredRoomType" id="preferredRoomType" class="form-select" required>
                    <option value="" disabled selected>-- Select Room Sharing --</option>
                    <option value="Single">Single (1 Bed)</option>
                    <option value="Double">Double (2 Beds)</option>
                    <option value="Triple">Triple (3 Beds)</option>
                    <option value="Four Sharing">Four Sharing (4 Beds)</option>
                  </select>
                </div>

                <div class="form-group">
                  <label class="form-label" for="reason">Reason / Special Requirements</label>
                  <textarea name="reason" id="reason" class="form-control" placeholder="E.g., Medical requirement, academic department proximity, or study preferences..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary btn-block">
                  <i class="fa-solid fa-paper-plane"></i> Submit Application
                </button>
              </form>
            <% } %>
          </div>
        </div>

        <!-- Guidelines & Information Card -->
        <div class="card">
          <div class="card-header">
            <h3><i class="fa-solid fa-circle-info" style="color: var(--secondary);"></i> Allotment Guidelines</h3>
          </div>
          <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem; font-size: 0.875rem; color: var(--slate-600);">
            <p>1. <strong>Capacity Allocation:</strong> Allotments are strictly subject to vacancy and hostel capacity rules. Once a room reaches full occupancy, no additional students can be allotted.</p>
            <p>2. <strong>Priority Order:</strong> Requests are processed based on submission time and distance eligibility criteria verified by the hostel warden.</p>
            <p>3. <strong>Approval Timeline:</strong> Standard processing time is 1 to 2 business days. The room status will update in your dashboard upon confirmation.</p>
          </div>
        </div>
      </div>

      <!-- Past Request History Table -->
      <div class="card" style="margin-top: 1.75rem;">
        <div class="card-header">
          <h3><i class="fa-solid fa-clock-rotate-left" style="color: var(--slate-600);"></i> Application History</h3>
        </div>
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Submission Date</th>
                <th>Preferred Block</th>
                <th>Room Type</th>
                <th>Reason</th>
                <th>Status</th>
                <th>Warden Remarks</th>
              </tr>
            </thead>
            <tbody>
              <% if (requests && requests.length > 0) { %>
                <% requests.forEach(function(r) { %>
                  <tr>
                    <td><%= new Date(r.createdAt).toLocaleDateString() %></td>
                    <td><%= r.preferredBlock ? r.preferredBlock.name : 'N/A' %></td>
                    <td><%= r.preferredRoomType %></td>
                    <td><%= r.reason || 'None specified' %></td>
                    <td>
                      <span class="badge <%= r.status === 'Approved' ? 'badge-approved' : r.status === 'Rejected' ? 'badge-rejected' : 'badge-pending' %>">
                        <%= r.status %>
                      </span>
                    </td>
                    <td><%= r.adminRemarks || '—' %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" style="text-align: center; color: var(--slate-400); padding: 2rem;">No previous room applications found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
