<%- include('../partials/header') %>

<div class="app-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="app-main">
    <%- include('../partials/topbar') %>

    <main class="app-content">
      <%- include('../partials/flash') %>

      <!-- Welcome Banner / Page Header -->
      <div class="page-header">
        <div class="page-header-info">
          <h1>Welcome, <%= student.name %></h1>
          <p>Student ID: <strong><%= student.studentId || 'N/A' %></strong> | Contact: <%= student.phone || 'Not added' %></p>
        </div>
        <div class="page-actions">
          <a href="/student/mess" class="btn btn-outline btn-sm">
            <i class="fa-solid fa-utensils"></i> Mess Timetable
          </a>
          <% if (!room) { %>
            <a href="/student/room-request" class="btn btn-primary btn-sm">
              <i class="fa-solid fa-file-circle-plus"></i> Request Room Allotment
            </a>
          <% } else { %>
            <a href="/student/maintenance" class="btn btn-primary btn-sm">
              <i class="fa-solid fa-wrench"></i> Raise Maintenance
            </a>
          <% } %>
        </div>
      </div>

      <!-- Current Room Status Hero Widget -->
      <% if (room) { %>
        <div class="my-room-hero">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
            <div>
              <span class="badge badge-available" style="background: rgba(16, 185, 129, 0.2); color: #a7f3d0; border-color: rgba(16, 185, 129, 0.3); margin-bottom: 0.75rem;">
                <i class="fa-solid fa-circle-check"></i> Officially Allotted
              </span>
              <h2>Room <%= room.roomNumber %></h2>
              <p><%= room.block ? room.block.name : 'Hostel Block' %> &bull; <%= room.roomType %> Room</p>
            </div>
            <div style="text-align: right;">
              <a href="/student/room" class="btn btn-secondary btn-sm" style="background: rgba(255,255,255,0.15); color: white; border: none;">
                <i class="fa-solid fa-door-open"></i> Full Room Details &rarr;
              </a>
            </div>
          </div>

          <div class="my-room-tags">
            <div class="my-room-tag">
              <i class="fa-solid fa-users"></i> Occupancy: <%= room.occupiedBeds %> / <%= room.capacity %> Beds
            </div>
            <div class="my-room-tag">
              <i class="fa-solid fa-venus-mars"></i> Block: <%= room.block ? room.block.gender : 'Co-ed' %>
            </div>
            <div class="my-room-tag">
              <i class="fa-solid fa-shield"></i> Status: <%= room.status %>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="card" style="margin-bottom: 1.75rem; border-left: 4px solid var(--warning);">
          <div class="card-body" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 1rem;">
              <div style="width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--warning-light); color: var(--warning); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                <i class="fa-solid fa-bed"></i>
              </div>
              <div>
                <h3 style="font-size: 1.1rem; color: var(--slate-900);">No Hostel Room Allotted Yet</h3>
                <p style="font-size: 0.875rem; color: var(--slate-600);">Submit an allotment request to choose your preferred hostel block and room type.</p>
              </div>
            </div>
            <a href="/student/room-request" class="btn btn-primary">
              <i class="fa-solid fa-paper-plane"></i> Apply for Room Allotment
            </a>
          </div>
        </div>
      <% } %>

      <!-- Status Trackers -->
      <% if (latestRoomRequest && latestRoomRequest.status === 'Pending') { %>
        <div class="alert alert-warning">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <i class="fa-solid fa-clock"></i>
            <div>
              <strong>Room Request Under Review:</strong> You requested a <%= latestRoomRequest.preferredRoomType %> room in <%= latestRoomRequest.preferredBlock ? latestRoomRequest.preferredBlock.name : 'preferred block' %> on <%= new Date(latestRoomRequest.createdAt).toLocaleDateString() %>.
            </div>
          </div>
          <span class="badge badge-pending">Pending Warden Approval</span>
        </div>
      <% } %>

      <% if (latestChangeRequest && latestChangeRequest.status === 'Pending') { %>
        <div class="alert alert-warning">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <i class="fa-solid fa-arrow-right-arrow-left"></i>
            <div>
              <strong>Room Transfer Request Under Review:</strong> Transfer to Room <%= latestChangeRequest.requestedRoom ? latestChangeRequest.requestedRoom.roomNumber : '' %> submitted on <%= new Date(latestChangeRequest.createdAt).toLocaleDateString() %>.
            </div>
          </div>
          <span class="badge badge-pending">Pending Transfer</span>
        </div>
      <% } %>

      <!-- Dashboard 2-Column Grid -->
      <div class="grid-2">
        <!-- Today's Mess Menu Card -->
        <div class="card">
          <div class="card-header">
            <h3><i class="fa-solid fa-calendar-day" style="color: var(--primary);"></i> Today's Dining Menu (<%= todayName %>)</h3>
            <a href="/student/mess" class="btn btn-outline btn-sm">Full Week &rarr;</a>
          </div>
          <div class="card-body">
            <% if (todayMeals) { %>
              <div style="display: flex; flex-direction: column; gap: 1rem;">
                <div style="background: var(--slate-50); padding: 0.85rem; border-radius: var(--radius-md); border-left: 3px solid #f59e0b;">
                  <div style="font-size: 0.75rem; font-weight: 700; color: #b45309; text-transform: uppercase;">Breakfast</div>
                  <div style="font-size: 0.9rem; font-weight: 500; color: var(--slate-800); margin-top: 0.2rem;"><%= todayMeals.breakfast %></div>
                </div>
                <div style="background: var(--slate-50); padding: 0.85rem; border-radius: var(--radius-md); border-left: 3px solid #10b981;">
                  <div style="font-size: 0.75rem; font-weight: 700; color: #047857; text-transform: uppercase;">Lunch</div>
                  <div style="font-size: 0.9rem; font-weight: 500; color: var(--slate-800); margin-top: 0.2rem;"><%= todayMeals.lunch %></div>
                </div>
                <div style="background: var(--slate-50); padding: 0.85rem; border-radius: var(--radius-md); border-left: 3px solid #ea580c;">
                  <div style="font-size: 0.75rem; font-weight: 700; color: #c2410c; text-transform: uppercase;">Evening Snacks</div>
                  <div style="font-size: 0.9rem; font-weight: 500; color: var(--slate-800); margin-top: 0.2rem;"><%= todayMeals.snacks %></div>
                </div>
                <div style="background: var(--slate-50); padding: 0.85rem; border-radius: var(--radius-md); border-left: 3px solid #6366f1;">
                  <div style="font-size: 0.75rem; font-weight: 700; color: #4338ca; text-transform: uppercase;">Dinner</div>
                  <div style="font-size: 0.9rem; font-weight: 500; color: var(--slate-800); margin-top: 0.2rem;"><%= todayMeals.dinner %></div>
                </div>
              </div>
            <% } else { %>
              <p style="color: var(--slate-500); font-size: 0.875rem;">No mess menu published for today yet.</p>
            <% } %>
          </div>
          <div class="card-footer">
            <a href="/student/feedback" class="btn btn-primary btn-sm btn-block">
              <i class="fa-solid fa-star"></i> Rate Today's Meals
            </a>
          </div>
        </div>

        <!-- Quick Info & Maintenance Column -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <!-- Latest Bill Summary Card -->
          <div class="card">
            <div class="card-header">
              <h3><i class="fa-solid fa-file-invoice-dollar" style="color: var(--success);"></i> Mess Bill Status</h3>
              <a href="/student/bills" class="btn btn-outline btn-sm">All Bills</a>
            </div>
            <div class="card-body">
              <% if (latestBill) { %>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <div>
                    <div style="font-size: 0.85rem; color: var(--slate-500);"><%= latestBill.month %> <%= latestBill.year %> Invoice</div>
                    <div style="font-size: 1.5rem; font-weight: 800; color: var(--slate-900); font-family: var(--font-heading); margin-top: 0.2rem;">
                      ₹<%= latestBill.totalAmount %>
                    </div>
                    <div style="font-size: 0.75rem; color: var(--slate-500); margin-top: 0.2rem;">
                      <%= latestBill.daysPresent %> Days &times; ₹<%= latestBill.perDayRate %>/day
                    </div>
                  </div>
                  <div>
                    <span class="badge <%= latestBill.status === 'Paid' ? 'badge-paid' : 'badge-unpaid' %>" style="font-size: 0.85rem; padding: 0.4rem 0.8rem;">
                      <%= latestBill.status %>
                    </span>
                  </div>
                </div>
              <% } else { %>
                <p style="color: var(--slate-500); font-size: 0.875rem;">No mess bills generated yet.</p>
              <% } %>
            </div>
          </div>

          <!-- Active Maintenance Tickets Card -->
          <div class="card">
            <div class="card-header">
              <h3><i class="fa-solid fa-screwdriver-wrench" style="color: var(--info);"></i> Maintenance Tickets</h3>
              <a href="/student/maintenance" class="btn btn-outline btn-sm">View All</a>
            </div>
            <div class="card-body">
              <% if (pendingMaintenance && pendingMaintenance.length > 0) { %>
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                  <% pendingMaintenance.slice(0, 3).forEach(function(m) { %>
                    <div style="padding: 0.75rem; background: var(--slate-50); border-radius: var(--radius-md); border: 1px solid var(--slate-200); display: flex; justify-content: space-between; align-items: center;">
                      <div>
                        <div style="font-weight: 600; font-size: 0.85rem; color: var(--slate-900);"><%= m.category %> Issue</div>
                        <div style="font-size: 0.75rem; color: var(--slate-500); margin-top: 0.15rem;"><%= m.description.substring(0, 45) %>...</div>
                      </div>
                      <span class="badge <%= m.status === 'Pending' ? 'badge-pending' : 'badge-in-progress' %>"><%= m.status %></span>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <p style="color: var(--slate-500); font-size: 0.875rem;">No active maintenance tickets pending.</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
