<%- include('../partials/header') %>

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at top, #eef2ff 0%, #f8fafc 80%); padding: 2rem 1rem;">
  <div style="max-width: 440px; width: 100%;">
    <!-- Brand Header -->
    <div style="text-align: center; margin-bottom: 2rem;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none;">
        <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: linear-gradient(135deg, var(--primary), var(--secondary)); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.3rem; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);">
          <i class="fa-solid fa-hotel"></i>
        </div>
        <div style="text-align: left;">
          <h2 style="font-size: 1.35rem; color: var(--slate-900);">CampusNest</h2>
          <span style="font-size: 0.75rem; color: var(--slate-500); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Hostel & Mess ERP</span>
        </div>
      </a>
      <h3 style="margin-top: 1.5rem; font-size: 1.4rem;">Sign in to your account</h3>
      <p style="color: var(--slate-500); font-size: 0.875rem; margin-top: 0.25rem;">Access student room services or admin warden controls</p>
    </div>

    <!-- Login Card -->
    <div class="card" style="box-shadow: var(--shadow-lg);">
      <div class="card-body" style="padding: 2rem;">
        <%- include('../partials/flash') %>

        <!-- 1-Click Demo Login Shortcuts -->
        <div style="background: var(--slate-50); border: 1px dashed var(--slate-300); border-radius: var(--radius-md); padding: 0.85rem; margin-bottom: 1.5rem;">
          <div style="font-size: 0.75rem; font-weight: 700; color: var(--slate-600); text-transform: uppercase; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
            <i class="fa-solid fa-bolt" style="color: #f59e0b;"></i> Quick 1-Click Evaluation Credentials:
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <button type="button" class="btn btn-secondary btn-sm" style="flex: 1; font-size: 0.75rem;" onclick="fillAdminDemo()">
              <i class="fa-solid fa-shield-halved"></i> Warden Admin
            </button>
            <button type="button" class="btn btn-secondary btn-sm" style="flex: 1; font-size: 0.75rem;" onclick="fillStudentDemo()">
              <i class="fa-solid fa-user-graduate"></i> Resident Student
            </button>
          </div>
        </div>

        <form action="/login" method="POST">
          <div class="form-group">
            <label class="form-label" for="loginEmail">Email Address</label>
            <div class="search-input-group" style="width: 100%;">
              <i class="fa-solid fa-envelope"></i>
              <input type="email" id="loginEmail" name="email" class="form-control" placeholder="name@hostel.edu" required autofocus>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="loginPassword">Password</label>
            <div class="search-input-group" style="width: 100%;">
              <i class="fa-solid fa-lock"></i>
              <input type="password" id="loginPassword" name="password" class="form-control" placeholder="••••••••" required>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 1.5rem;">
            <i class="fa-solid fa-right-to-bracket"></i> Sign In
          </button>
        </form>
      </div>

      <div class="card-footer" style="justify-content: center; background: var(--slate-50); padding: 1.25rem;">
        <span style="font-size: 0.85rem; color: var(--slate-600);">New resident?</span>
        <a href="/register" style="font-size: 0.85rem; font-weight: 600;">Create an account</a>
      </div>
    </div>

    <div style="text-align: center; margin-top: 1.5rem;">
      <a href="/" style="font-size: 0.85rem; color: var(--slate-500); display: inline-flex; align-items: center; gap: 0.35rem;">
        <i class="fa-solid fa-arrow-left"></i> Return to Homepage
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
