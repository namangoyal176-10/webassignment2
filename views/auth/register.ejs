<%- include('../partials/header') %>

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at top, #eef2ff 0%, #f8fafc 80%); padding: 2.5rem 1rem;">
  <div style="max-width: 520px; width: 100%;">
    <!-- Brand Header -->
    <div style="text-align: center; margin-bottom: 2rem;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none;">
        <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: linear-gradient(135deg, var(--primary), var(--secondary)); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.3rem; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);">
          <i class="fa-solid fa-hotel"></i>
        </div>
        <div style="text-align: left;">
          <h2 style="font-size: 1.35rem; color: var(--slate-900);">CampusNest</h2>
          <span style="font-size: 0.75rem; color: var(--slate-500); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Hostel & Mess ERP</span>
        </div>
      </a>
      <h3 style="margin-top: 1.5rem; font-size: 1.4rem;">Student Registration</h3>
      <p style="color: var(--slate-500); font-size: 0.875rem; margin-top: 0.25rem;">Create a resident profile to request room allotment and mess facilities</p>
    </div>

    <!-- Registration Card -->
    <div class="card" style="box-shadow: var(--shadow-lg);">
      <div class="card-body" style="padding: 2rem;">
        <%- include('../partials/flash') %>

        <form action="/register" method="POST">
          <div class="form-group">
            <label class="form-label" for="regName">Full Name *</label>
            <div class="search-input-group" style="width: 100%;">
              <i class="fa-solid fa-user"></i>
              <input type="text" id="regName" name="name" class="form-control" placeholder="Aarav Sharma" required>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label" for="regEmail">College Email *</label>
              <div class="search-input-group" style="width: 100%;">
                <i class="fa-solid fa-envelope"></i>
                <input type="email" id="regEmail" name="email" class="form-control" placeholder="aarav@hostel.edu" required>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="regStudentId">Student ID / Enrollment *</label>
              <div class="search-input-group" style="width: 100%;">
                <i class="fa-solid fa-id-badge"></i>
                <input type="text" id="regStudentId" name="studentId" class="form-control" placeholder="STU-2026-001" required>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="regPhone">Phone Number</label>
            <div class="search-input-group" style="width: 100%;">
              <i class="fa-solid fa-phone"></i>
              <input type="tel" id="regPhone" name="phone" class="form-control" placeholder="9876543210">
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label" for="regPassword">Password *</label>
              <div class="search-input-group" style="width: 100%;">
                <i class="fa-solid fa-lock"></i>
                <input type="password" id="regPassword" name="password" class="form-control" placeholder="Min. 6 chars" minlength="6" required>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="regConfirmPassword">Confirm Password *</label>
              <div class="search-input-group" style="width: 100%;">
                <i class="fa-solid fa-check-double"></i>
                <input type="password" id="regConfirmPassword" name="confirmPassword" class="form-control" placeholder="Repeat password" required>
              </div>
            </div>
          </div>

          <div style="background: var(--slate-50); border-radius: var(--radius-sm); padding: 0.75rem; font-size: 0.75rem; color: var(--slate-600); margin-bottom: 1.25rem;">
            <i class="fa-solid fa-circle-info" style="color: var(--primary);"></i>
            By registering, you are enrolled as a student resident. Admin accounts are managed directly by the college administration.
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-lg">
            <i class="fa-solid fa-user-plus"></i> Complete Registration
          </button>
        </form>
      </div>

      <div class="card-footer" style="justify-content: center; background: var(--slate-50); padding: 1.25rem;">
        <span style="font-size: 0.85rem; color: var(--slate-600);">Already have an account?</span>
        <a href="/login" style="font-size: 0.85rem; font-weight: 600;">Sign in here</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
