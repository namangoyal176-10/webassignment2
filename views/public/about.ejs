<%- include('../partials/header') %>

<div style="min-height: 100vh; display: flex; flex-direction: column;">
  <!-- Top Navigation -->
  <nav style="background: var(--white); border-bottom: 1px solid var(--slate-200); padding: 1rem 2rem; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50;">
    <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none;">
      <div style="width: 36px; height: 36px; border-radius: var(--radius-md); background: linear-gradient(135deg, var(--primary), var(--secondary)); display: flex; align-items: center; justify-content: center; color: white;">
        <i class="fa-solid fa-hotel"></i>
      </div>
      <div>
        <h3 style="font-size: 1.15rem; color: var(--slate-900);">CampusNest</h3>
        <span style="font-size: 0.72rem; color: var(--slate-500); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Hostel & Mess Management</span>
      </div>
    </a>

    <div style="display: flex; align-items: center; gap: 1rem;">
      <a href="/" class="btn btn-outline btn-sm"><i class="fa-solid fa-arrow-left"></i> Home</a>
      <a href="/login" class="btn btn-primary btn-sm"><i class="fa-solid fa-right-to-bracket"></i> Login</a>
    </div>
  </nav>

  <div style="max-width: 1000px; margin: 3rem auto; padding: 0 1.5rem; width: 100%; flex: 1;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <span class="badge badge-partially-occupied" style="margin-bottom: 0.75rem;">Information & Guidelines</span>
      <h1>Hostel Rules, Mess Timings & Facilities</h1>
      <p style="color: var(--slate-500); margin-top: 0.5rem;">Important instructions and standard operational procedures for residents.</p>
    </div>

    <!-- Dining Timings -->
    <div class="card" style="margin-bottom: 2rem;">
      <div class="card-header">
        <h3><i class="fa-solid fa-clock" style="color: var(--primary);"></i> Daily Mess Timings</h3>
      </div>
      <div class="card-body">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem;">
          <div style="background: var(--slate-50); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--slate-200);">
            <div style="font-weight: 700; color: var(--slate-900);"><i class="fa-solid fa-sun" style="color: #f59e0b;"></i> Breakfast</div>
            <div style="font-size: 1.1rem; font-weight: 800; color: var(--primary); margin: 0.35rem 0;">07:30 AM – 09:30 AM</div>
            <div style="font-size: 0.8rem; color: var(--slate-500);">Monday through Sunday</div>
          </div>
          <div style="background: var(--slate-50); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--slate-200);">
            <div style="font-weight: 700; color: var(--slate-900);"><i class="fa-solid fa-utensils" style="color: #10b981;"></i> Lunch</div>
            <div style="font-size: 1.1rem; font-weight: 800; color: var(--primary); margin: 0.35rem 0;">12:30 PM – 02:30 PM</div>
            <div style="font-size: 0.8rem; color: var(--slate-500);">Includes dessert on weekends</div>
          </div>
          <div style="background: var(--slate-50); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--slate-200);">
            <div style="font-weight: 700; color: var(--slate-900);"><i class="fa-solid fa-mug-hot" style="color: #ea580c;"></i> Evening Snacks</div>
            <div style="font-size: 1.1rem; font-weight: 800; color: var(--primary); margin: 0.35rem 0;">05:00 PM – 06:15 PM</div>
            <div style="font-size: 0.8rem; color: var(--slate-500);">Tea, Coffee & Fresh Snacks</div>
          </div>
          <div style="background: var(--slate-50); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--slate-200);">
            <div style="font-weight: 700; color: var(--slate-900);"><i class="fa-solid fa-moon" style="color: #6366f1;"></i> Dinner</div>
            <div style="font-size: 1.1rem; font-weight: 800; color: var(--primary); margin: 0.35rem 0;">07:45 PM – 09:45 PM</div>
            <div style="font-size: 0.8rem; color: var(--slate-500);">Full meal service</div>
          </div>
        </div>
      </div>
    </div>

    <!-- General Code of Conduct -->
    <div class="card" style="margin-bottom: 2rem;">
      <div class="card-header">
        <h3><i class="fa-solid fa-shield-halved" style="color: var(--secondary);"></i> Resident Code of Conduct</h3>
      </div>
      <div class="card-body" style="display: flex; flex-direction: column; gap: 1rem;">
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <div style="width: 28px; height: 28px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">1</div>
          <div>
            <div style="font-weight: 600; color: var(--slate-900);">Quiet Hours & Study Atmosphere</div>
            <p style="font-size: 0.875rem; color: var(--slate-600); margin-top: 0.2rem;">Quiet hours are observed strictly between 10:30 PM and 06:00 AM daily to facilitate undisturbed studying and rest.</p>
          </div>
        </div>

        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <div style="width: 28px; height: 28px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">2</div>
          <div>
            <div style="font-weight: 600; color: var(--slate-900);">Room Allocation & Key Handling</div>
            <p style="font-size: 0.875rem; color: var(--slate-600); margin-top: 0.2rem;">Room exchanges must be formally requested and approved through the portal. Unauthorized room swapping is strictly forbidden.</p>
          </div>
        </div>

        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <div style="width: 28px; height: 28px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">3</div>
          <div>
            <div style="font-weight: 600; color: var(--slate-900);">Maintenance Complaint Reporting</div>
            <p style="font-size: 0.875rem; color: var(--slate-600); margin-top: 0.2rem;">All plumbing, electrical, carpentry, or WiFi defects should be registered through the Maintenance portal for timely technician dispatch.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <footer style="margin-top: auto; background: var(--slate-900); color: var(--slate-400); padding: 2rem; text-align: center;">
    <div style="font-size: 0.85rem;">&copy; <%= new Date().getFullYear() %> CampusNest System. All rights reserved.</div>
  </footer>
</div>

<%- include('../partials/footer') %>
