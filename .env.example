# Application Port
PORT=3000

# Environment (development | production)
NODE_ENV=development

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/hostel_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hostel_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hostel_db

# Session Secret (Generate a strong random 32+ character string in production)
SESSION_SECRET=hostel_management_system_secure_secret_key_2026_jwt_session

# Default Admin Credentials (Used by seed script)
ADMIN_EMAIL=admin@hostel.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Chief Warden
ADMIN_PHONE=9876543210
